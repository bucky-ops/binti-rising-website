// Binti Rising Initiative - Prisma schema
// DATA PRIVACY (Kenya DPA 2019): This schema stores ONLY
//  - aggregated KPI snapshots (no personal identifiers), and
//  - minimal consented data from the Join Circle form (initials, age, area).
// Full names, national IDs, exact home locations are NEVER stored.
// Phone number is optional, stored only with explicit DPA consent,
// and is never rendered by any API or UI surface.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// Join Circle form submissions (For Youth)
model JoinRequest {
  id              String   @id @default(cuid())
  displayName     String // initials only, e.g. "F.W." - full names rejected server-side
  age             Int // validated 15-25
  area            String // Kibera | Mathare | Kawangware | Other
  phone           String? // optional, DPA consent required, never displayed
  consentDpa      Boolean // Kenya DPA 2019 consent checkbox
  guardianConsent Boolean  @default(false) // required when age < 18
  status          String   @default("pending") // pending | placed | contacted
  createdAt       DateTime @default(now())
}

// Anonymous complaints / safety reports (Accountability)
model Complaint {
  id           String   @id @default(cuid())
  reference    String   @unique // anonymous ref, e.g. "BRI-2026-0042"
  category     String // safeguarding | fraud | data | other
  message      String // free text, user is told NOT to include their own name
  hasVoiceNote Boolean  @default(false)
  voiceNote    String? // base64 audio (webm), size-capped server-side, NEVER rendered publicly
  status       String   @default("received") // received | reviewing | actioned | closed
  createdAt    DateTime @default(now())
}

// Donor/community newsletter opt-in (Get Involved). DPA 2019: explicit consent
// checkbox is mandatory; email is stored only for sending the newsletter and
// is never displayed anywhere.
model Newsletter {
  id         String   @id @default(cuid())
  email      String   @unique
  consentDpa Boolean // must be true - enforced server-side
  source     String   @default("footer-form")
  createdAt  DateTime @default(now())
}

// Partner inquiries (Get Involved → For Partners). Institutional contacts
// (funders, NGOs, government, corporates) - NOT beneficiary data. Partner
// contact details are stored only for partnership correspondence, with an
// explicit DPA 2019 notice + consent checkbox on the form. Beneficiary
// privacy rules (initials-only) do not apply here because the submitter is
// an organisation representative, but data minimisation still applies:
// only fields needed to start a partnership are collected.
model PartnerInquiry {
  id           String   @id @default(cuid())
  reference    String   @unique // shared externally, e.g. "PTN-2026-740841"
  orgName      String
  contactName  String
  role         String?
  email        String
  orgType      String // funder | ngo | government | corporate | community
  interests    String // comma-separated: funding | referral | content | technical | volunteering
  message      String?
  consentDpa   Boolean // must be true - enforced server-side
  status       String   @default("new") // new | contacted | mou-sent | active | closed
  createdAt    DateTime @default(now())
}

// Aggregated monthly KPI snapshots feeding the Live Impact Dashboard.
// One row per (month, area). No PII anywhere - counts and percentages only.
model KpiMonthly {
  id              String   @id @default(cuid())
  month           String // "2026-04"
  area            String // Kibera | Mathare | Kawangware | ALL
  youthEnrolled   Int
  sessionsHeld    Int
  attendancePct   Float
  referralsOpen   Int
  referralsClosed Int
  wellbeingAvg    Float // 0-100 average wellbeing score
  source          String   @default("SSK aggregation (masked)")
  updatedAt       DateTime @updatedAt

  @@unique([month, area])
}
